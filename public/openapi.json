          },
          "401": {
            "description": "Invalid credential"
          },
          "403": {
            "description": "Scope or account access denied"
          },
          "404": {
            "description": "Not found or inaccessible"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limited; honor RateLimit-Reset"
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          }
