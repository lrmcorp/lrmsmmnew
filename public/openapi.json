    "/agent/drafts": {
      "post": {
        "summary": "Submit a private draft for dashboard approval",
        "operationId": "post_agent_drafts",
        "responses": {
          "200": {
            "description": "Success (creation may return 201; completion/part writes may return 204)",
            "content": {
              "application/json": {
                "schema": {
