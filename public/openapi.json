        },
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "in_library",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ]
      }
    },
    "/media/uploads": {
      "post": {
        "summary": "Start a resumable chunked upload",
        "operationId": "post_media_uploads",
        "responses": {
          "200": {
            "description": "Success (creation may return 201; completion/part writes may return 204)"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credential"
          },
          "403": {
            "description": "Scope or account access denied"
          },
          "404": {
            "description": "Not found or inaccessible"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limited; honor RateLimit-Reset"
          },
          "201": {
            "description": "Created"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mime_type",
                  "size_bytes"
                ],
                "properties": {
                  "mime_type": {
                    "type": "string",
                    "enum": [
                      "image/jpeg",
                      "image/png",
                      "video/mp4",
                      "video/quicktime"
                    ]
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 314572800
                  },
                  "original_name": {
                    "type": "string"
                  },
                  "in_library": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        }
      }
    },
