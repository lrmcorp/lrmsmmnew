{
  "openapi": "3.1.0",
  "info": {
    "title": "LRMsmm Agent Publishing API",
    "version": "1.2.0",
    "description": "Authenticated external agent publishing and private review drafts. See /agent-api.md for limits, chunking, retries and approval rules."
  },
  "servers": [
    {
      "url": "https://lrmsosmed.playgo.id/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal LRMsmm API key (lrm_live_...) or personal OAuth token. OAuth is draft-only for publishing."
      }
    },
    "schemas": {
      "Target": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Submission": {
        "type": "object",
        "required": [
          "content",
          "targets"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "media_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered ready uploads; 2\u201310 for Instagram carousel."
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Target"
            }
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timezone required. Draft: proposed schedule only. POST /posts: omit to publish now."
          }
        }
      },
      "Draft": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Submission"
          },
          {
            "type": "object",
            "required": [
              "request_id"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "maxLength": 100
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "base64": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "DraftResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "cancelled"
            ]
          },
          "compose_url": {
            "type": "string",
            "format": "uri"
          },
          "post_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "List me",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Success (creation may return 201; completion/part writes may return 204)"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credential"
          },
          "403": {
            "description": "Scope or account access denied"
          },
          "404": {
            "description": "Not found or inaccessible"
          },
          "409": {
            "description": "Conflict"
          },
          "429": {
            "description": "Rate limited; honor RateLimit-Reset"
          }
        }
      }
    },
    "/companies": {
      "get": {
        "summary": "List companies",
        "operationId": "get_companies",
