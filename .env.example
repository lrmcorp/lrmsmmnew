# ---- Wajib ----
# URL publik HTTPS tempat Siar bisa diakses. Meta mengambil foto/video dari URL ini saat posting,
# jadi HARUS bisa diakses dari internet (bukan localhost).
PUBLIC_URL=https://siar.playgo.id
PORT=3000
NODE_ENV=production

# Kunci enkripsi token Meta (AES-256-GCM). Buat sekali: openssl rand -hex 32
# JANGAN diganti setelah ada akun tersambung — token lama jadi tidak bisa dibuka.
ENCRYPTION_KEY=

# ---- Meta App: Instagram (Instagram API with Instagram Login) ----
# developers.facebook.com → app kamu → Instagram → API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=

# ---- Meta App: Threads ----
# developers.facebook.com → app kamu → Threads API → Settings
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---- Opsional ----
DATA_DIR=./data
APP_TIMEZONE=Asia/Jakarta
# 1 = siapa pun boleh daftar. Default tertutup: user pertama jadi admin, sisanya ditambah admin.
ALLOW_SIGNUP=0
# Email notifikasi (post gagal / akun perlu disambung ulang), format nodemailer
# SMTP_URL=smtps://user:pass@smtp.gmail.com:465
# MAIL_FROM=Siar <siar@hrgroup.id>
# Mode simulasi tanpa Meta (untuk coba-coba lokal)
# META_MOCK=1
